<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<!-- LABEL -->

	<Style x:Key="MainLabelStyle"
           TargetType="{x:Type Label}">

		<Setter Property="FontSize"
                Value="20"/>

		<Setter Property="VerticalAlignment"
                Value="Center"/>

		<Setter Property="Margin"
                Value="0,0,10,0"/>

	</Style>


	<!-- TEXT BOX -->

	<Style x:Key="MainTextBoxStyle"
           TargetType="{x:Type TextBox}">

		<Setter Property="FontSize"
                Value="18"/>

		<Setter Property="Height"
                Value="30"/>

		<Setter Property="VerticalContentAlignment"
                Value="Center"/>

		<Setter Property="HorizontalContentAlignment"
                Value="Left"/>

	</Style>

	<!-- LIST BOX -->

	<Style x:Key="MainListBoxStyle"
           TargetType="{x:Type ListBox}">

		<Setter Property="FontSize"
                Value="14"/>

		<Setter Property="BorderBrush"
                Value="#FF3F3F46"/>

		<Setter Property="BorderThickness"
                Value="1"/>

	</Style>

	<!-- CLEAR (X) BUTTON -->

	<Style x:Key="ClearButtonStyle"
           TargetType="{x:Type Button}">

		<Setter Property="Width"
                Value="24"/>

		<Setter Property="Height"
                Value="24"/>

		<Setter Property="Cursor"
                Value="Hand"/>

		<Setter Property="Background"
                Value="Transparent"/>

		<Setter Property="BorderThickness"
                Value="0"/>

		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type Button}">
					<Border x:Name="ClearBorder"
                            Background="Transparent"
                            Width="24"
                            Height="24">

						<Canvas Width="14"
                                Height="14"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">

							<Line x:Name="Line1"
                                  X1="0" Y1="0"
                                  X2="14" Y2="14"
                                  Stroke="#FFC0392B"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"/>

							<Line x:Name="Line2"
                                  X1="14" Y1="0"
                                  X2="0" Y2="14"
                                  Stroke="#FFC0392B"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"/>

						</Canvas>

					</Border>

					<ControlTemplate.Triggers>

						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Line1"
                                    Property="Stroke"
                                    Value="#FF7B241C"/>
							<Setter TargetName="Line2"
                                    Property="Stroke"
                                    Value="#FF7B241C"/>
						</Trigger>

						<Trigger Property="IsPressed" Value="True">
							<Setter TargetName="Line1"
                                    Property="Stroke"
                                    Value="#FF641E16"/>
							<Setter TargetName="Line2"
                                    Property="Stroke"
                                    Value="#FF641E16"/>
						</Trigger>

					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>

	</Style>	<!-- BUTTON -->

	<Style x:Key="MainButtonStyle"
           TargetType="{x:Type Button}">

		<Setter Property="FontSize"
                Value="16"/>

		<Setter Property="Height"
                Value="30"/>

		<Setter Property="Padding"
                Value="15,0"/>

		<Setter Property="Margin"
                Value="10,0,0,0"/>

		<Setter Property="VerticalAlignment"
                Value="Center"/>

		<Setter Property="Cursor"
                Value="Hand"/>

		<Setter Property="Background"
                Value="#d9d9d9"/>

		<Setter Property="Foreground"
                Value="#0d0d0d"/>

		<Setter Property="BorderBrush"
                Value="#BFBFBF"/>

		<Setter Property="BorderThickness"
                Value="1.5"/>

		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type Button}">
					<Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
						<ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            RecognizesAccessKey="True"/>
					</Border>

					<ControlTemplate.Triggers>

						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="#BDBDBD"/>
						</Trigger>

						<Trigger Property="IsPressed" Value="True">
							<Setter TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="#B3B3B3"/>
						</Trigger>

						<Trigger Property="IsEnabled" Value="False">
							<Setter TargetName="ButtonBorder"
                                    Property="Opacity"
                                    Value="0.5"/>
						</Trigger>

					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>

	</Style>

	<!-- SUB LABEL (mniejszy label do sekcji pomocniczych, np. "View:") -->

	<Style x:Key="SubLabelStyle"
           TargetType="{x:Type Label}"
           BasedOn="{StaticResource MainLabelStyle}">

		<Setter Property="FontSize"
                Value="16"/>

		<Setter Property="Foreground"
                Value="#4D4D4D"/>

	</Style>

	<!-- SEGMENTED CONTROL CONTAINER (otoczka dla RadioButtonów) -->

	<Style x:Key="SegmentGroupBorderStyle"
           TargetType="{x:Type Border}">

		<Setter Property="Background"
                Value="#F2F2F2"/>

		<Setter Property="BorderBrush"
                Value="#BFBFBF"/>

		<Setter Property="BorderThickness"
                Value="1"/>

		<Setter Property="CornerRadius"
                Value="8"/>

		<Setter Property="Padding"
                Value="3"/>

	</Style>

	<!-- SEGMENTED RADIO BUTTON (opcje View) -->

	<Style x:Key="SegmentRadioButtonStyle"
           TargetType="{x:Type RadioButton}">

		<Setter Property="FontSize"
                Value="14"/>

		<Setter Property="Padding"
                Value="14,6"/>

		<Setter Property="Cursor"
                Value="Hand"/>

		<Setter Property="Foreground"
                Value="#0D0D0D"/>

		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type RadioButton}">
					<Border x:Name="SegmentBorder"
                            Background="Transparent"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">

						<ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>

					</Border>

					<ControlTemplate.Triggers>

						<Trigger Property="IsChecked" Value="True">
							<Setter TargetName="SegmentBorder"
                                    Property="Background"
                                    Value="#D9D9D9"/>
						</Trigger>

						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition Property="IsMouseOver" Value="True"/>
								<Condition Property="IsChecked" Value="False"/>
							</MultiTrigger.Conditions>
							<Setter TargetName="SegmentBorder"
                                    Property="Background"
                                    Value="#EAEAEA"/>
						</MultiTrigger>

					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>

	</Style>

	<!-- DROPDOWN (menu zapisu PNG / SVG) -->

	<Style x:Key="DropdownHeaderStyle"
           TargetType="{x:Type TextBlock}">

		<Setter Property="FontSize"
                Value="12"/>

		<Setter Property="Foreground"
                Value="#7A7A7A"/>

		<Setter Property="Margin"
                Value="10,8,10,4"/>

	</Style>

	<Style x:Key="DropdownItemStyle"
           TargetType="{x:Type Button}">

		<Setter Property="FontSize"
                Value="14"/>

		<Setter Property="Height"
                Value="30"/>

		<Setter Property="Padding"
                Value="12,0"/>

		<Setter Property="HorizontalContentAlignment"
                Value="Left"/>

		<Setter Property="Background"
                Value="Transparent"/>

		<Setter Property="BorderThickness"
                Value="0"/>

		<Setter Property="Cursor"
                Value="Hand"/>

		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type Button}">
					<Border x:Name="ItemBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
						<ContentPresenter
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"/>
					</Border>

					<ControlTemplate.Triggers>

						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="ItemBorder"
                                    Property="Background"
                                    Value="#EAF2FB"/>
						</Trigger>

						<Trigger Property="IsPressed" Value="True">
							<Setter TargetName="ItemBorder"
                                    Property="Background"
                                    Value="#D6E6F7"/>
						</Trigger>

					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>

	</Style>

	<!-- CHECKBOX (opcja "Show files") -->

	<Style x:Key="OptionCheckBoxStyle"
           TargetType="{x:Type CheckBox}">

		<Setter Property="FontSize"
                Value="14"/>

		<Setter Property="Foreground"
                Value="#0D0D0D"/>

		<Setter Property="VerticalAlignment"
                Value="Center"/>

		<Setter Property="Margin"
                Value="14,0,0,0"/>

		<Setter Property="Cursor"
                Value="Hand"/>

	</Style>


</ResourceDictionary>