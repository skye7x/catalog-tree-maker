!**/[Pp]ackages/build/
project.lock.json
project.fragment.lock.json

# ---- Test / coverage ----
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.coverage
*.coveragexml
coverage*.json
coverage*.xml
*.trx

# ---- Publish / single-file ----
*.Publish.xml
*.pubxml.user

# ---- OS junk ----
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# ---- Logs / temp ----
*.log
*.tmp
